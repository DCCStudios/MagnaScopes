# Deployed-artifact snapshots taken before each in-game candidate, and the
# local copies of third-party material kept only for comparison. Both are
# large binary trees that must never enter history.
/deployment_backups/
/_reference/
*.pdb

/tests/**/bin/
/tests/**/obj/
/tests/**/build/
/tests/**/.xmake/
/src/.xmake/

# Conversion test inputs/outputs: extracted third-party weapon-mod meshes,
# materials, and textures plus the converted candidates built from them.
# Same policy as /_reference/ -- comparison-only binary trees stay out of
# history. The loose reference NIFs directly under meshes/ remain tracked.
/tests/NifInspector/meshes/Conversion/
/tests/NifInspector/meshes/Materials/
/tests/NifInspector/meshes/STS Reference Scope Meshes/

__pycache__/
